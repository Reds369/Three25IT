@using Three25IT.Models

@{
    var openTickets = ViewData["OpenTicketCount"] as int? ?? 0;
    string Active(string controller, string action) =>
        (ViewContext.RouteData.Values["controller"]?.ToString() == controller
         && ViewContext.RouteData.Values["action"]?.ToString() == action) ? "active" : "";
}

<aside class="portal-sidebar">
    <div class="side-brand">
        <img src="~/img/logo-white.svg" alt="Three25IT" />
    </div>
    <div class="side-user">
        <span class="name">@User.Identity?.Name</span>
        Signed in to your customer portal
    </div>
    <nav class="nav">
        <a class="nav-link @Active("Portal", "Index")" asp-controller="Portal" asp-action="Index">
            <span class="ico"><i class="bi bi-speedometer2"></i></span> Dashboard
        </a>
        <a class="nav-link @Active("Service", "Index")" asp-controller="Service" asp-action="Index">
            <span class="ico"><i class="bi bi-router"></i></span> My Service
        </a>
        <a class="nav-link @Active("Billing", "Index")" asp-controller="Billing" asp-action="Index">
            <span class="ico"><i class="bi bi-credit-card"></i></span> Billing
        </a>
        <a class="nav-link @Active("Usage", "Index")" asp-controller="Usage" asp-action="Index">
            <span class="ico"><i class="bi bi-graph-up-arrow"></i></span> Usage
        </a>
        <a class="nav-link @Active("Support", "Index")" asp-controller="Support" asp-action="Index">
            <span class="ico"><i class="bi bi-life-preserver"></i></span> Support
            @if (openTickets > 0)
            {
                <span class="badge rounded-pill text-bg-info ms-auto">@openTickets</span>
            }
        </a>
        <a class="nav-link @Active("Manage", "Index")" asp-controller="Manage" asp-action="Index">
            <span class="ico"><i class="bi bi-person-gear"></i></span> My Account
        </a>
    </nav>
    <div class="px-2 pt-3 mt-2" style="border-top: 1px solid rgba(255,255,255,0.12);">
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-sm btn-outline-light w-100">
                <i class="bi bi-box-arrow-left me-1"></i> Sign out
            </button>
        </form>
    </div>
</aside>
