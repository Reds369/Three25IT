@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="auth-wrapper">
    <div class="container">
        <div class="auth-card text-center">
            <div class="auth-head">
                <img src="~/img/logo.svg" alt="Three25IT" />
                <div class="display-5 mb-2" style="color: var(--t25-blue);"><i class="bi bi-exclamation-triangle"></i></div>
                <h1>Something went wrong</h1>
                <p>We hit an unexpected error while loading this page. Please try again in a moment.</p>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="demo-hint mb-3">
                    <span class="d-block mb-1">If you contact support, please quote this request ID:</span>
                    <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
                <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Contact">Contact support</a>
            </div>
        </div>
    </div>
</section>
