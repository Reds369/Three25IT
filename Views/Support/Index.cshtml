@model SupportViewModel
@{
    ViewData["Title"] = "Support";
    Layout = "_PortalLayout";
    ViewData["OpenTicketCount"] = Model.Tickets.Count(t => t.TicketStatus == TicketStatuses.Open);

    string StatusClass(string status) => status switch
    {
        TicketStatuses.Open => "badge-open",
        TicketStatuses.InProgress => "badge-progress",
        TicketStatuses.AwaitingCustomer => "badge-waiting",
        TicketStatuses.Resolved => "badge-resolved",
        _ => "badge-closed"
    };

    string PriorityClass(string priority) => priority switch
    {
        TicketPriorities.High => "badge-high",
        TicketPriorities.Urgent => "badge-urgent",
        TicketPriorities.Low => "badge-low",
        _ => "badge-normal"
    };
}

<div class="portal-shell">
    <partial name="_Sidebar" />

    <div class="portal-content">
        <div class="portal-header">
            <div>
                <h1>Support</h1>
                <p class="sub">Track your tickets, report a fault or ask us anything.</p>
            </div>
            <a class="btn btn-primary" asp-action="New">
                <i class="bi bi-plus-lg me-1"></i>New ticket
            </a>
        </div>

        <partial name="_Alerts" />

        <div class="panel">
            <form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
                <div class="col-md-3">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" name="status" id="status">
                        @foreach (var status in new[] { "All", TicketStatuses.Open, TicketStatuses.InProgress, TicketStatuses.AwaitingCustomer, TicketStatuses.Resolved, TicketStatuses.Closed })
                        {
                            <option value="@status" selected="@(Model.FilterStatus == status)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="category" class="form-label">Category</label>
                    <select class="form-select" name="category" id="category">
                        @foreach (var category in new[] { "All", TicketCategories.Technical, TicketCategories.Billing, TicketCategories.Installation, TicketCategories.Upgrading, TicketCategories.General })
                        {
                            <option value="@category" selected="@(Model.FilterCategory == category)">@category</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="search" class="form-label">Search</label>
                    <input class="form-control" type="text" name="search" id="search"
                           value="@Model.Search" placeholder="Subject or ticket number" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1" type="submit">Filter</button>
                    <a class="btn btn-outline-secondary" asp-action="Index" title="Clear filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>

            @if (Model.Tickets.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Subject</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Last updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model.Tickets)
                            {
                                <tr class="row-link">
                                    <td class="fw-semibold">
                                        <a asp-action="Detail" asp-route-id="@ticket.Id" class="text-decoration-none">
                                            @ticket.TicketNumber
                                        </a>
                                    </td>
                                    <td>@ticket.Subject</td>
                                    <td class="text-muted">@ticket.Category</td>
                                    <td><span class="status-badge @PriorityClass(ticket.Priority)">@ticket.Priority</span></td>
                                    <td><span class="status-badge @StatusClass(ticket.TicketStatus)">@ticket.TicketStatus</span></td>
                                    <td class="text-muted">@ticket.UpdatedAt.ToString("d MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="icon"><i class="bi bi-inbox"></i></div>
                    <h2 class="h5" style="color: var(--t25-navy);">No tickets found</h2>
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Search) || Model.FilterStatus == "All"
                            ? "You haven't raised any support tickets yet."
                            : "No tickets match the filters you selected.")
                    </p>
                    <a class="btn btn-primary" asp-action="New">
                        <i class="bi bi-plus-lg me-1"></i>Raise a ticket
                    </a>
                </div>
            }
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="panel mb-0">
                    <h2>Report a line fault faster</h2>
                    <p class="text-muted" style="font-size: 0.9rem;">
                        Before logging a technical ticket, try these - they resolve most issues in
                        under a minute.
                    </p>
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="t-title">Reboot the router and ONT</div>
                            <div class="t-meta">Power off the ONT, wait 30 seconds, then power back on and allow 2 minutes to resync</div>
                        </div>
                        <div class="timeline-item">
                            <div class="t-title">Check for a maintenance notice</div>
                            <div class="t-meta">Planned work is announced 48 hours in advance on your dashboard</div>
                        </div>
                        <div class="timeline-item">
                            <div class="t-title">Test on a wired connection</div>
                            <div class="t-meta">Plug a laptop directly into the ONT to rule out WiFi interference</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="panel mb-0">
                    <h2>Response targets</h2>
                    <p class="text-muted" style="font-size: 0.9rem;">
                        Based on the priority you choose when raising a ticket.
                    </p>
                    <div class="detail-row">
                        <span class="k"><span class="status-badge badge-urgent">Urgent</span></span>
                        <span class="v">1 hour (total outage)</span>
                    </div>
                    <div class="detail-row">
                        <span class="k"><span class="status-badge badge-high">High</span></span>
                        <span class="v">4 hours</span>
                    </div>
                    <div class="detail-row">
                        <span class="k"><span class="status-badge badge-normal">Normal</span></span>
                        <span class="v">Same working day</span>
                    </div>
                    <div class="detail-row">
                        <span class="k"><span class="status-badge badge-low">Low</span></span>
                        <span class="v">2 working days</span>
                    </div>
                    <div class="mt-3 text-muted" style="font-size: 0.86rem;">
                        For a complete outage you can also call
                        <a href="tel:0860000326">0860 000 326</a>, 24 hours a day.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
