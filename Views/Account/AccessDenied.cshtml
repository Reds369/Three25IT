@{
    ViewData["Title"] = "Access denied";
}

<section class="auth-wrapper">
    <div class="container">
        <div class="auth-card text-center">
            <div class="auth-head">
                <img src="~/img/logo.svg" alt="Three25IT" />
                <div class="display-5 mb-2 text-muted"><i class="bi bi-shield-lock"></i></div>
                <h1>You don't have access to that page</h1>
                <p>Your account doesn't have permission to view this. If you think that's wrong, log out and back in.</p>
            </div>

            <a class="btn btn-primary" asp-controller="Portal" asp-action="Index">
                Go to my dashboard
            </a>
        </div>
    </div>
</section>
