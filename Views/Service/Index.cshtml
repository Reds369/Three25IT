@model MyServiceViewModel
@{
    ViewData["Title"] = "My Service";
    Layout = "_PortalLayout";
    ViewData["OpenTicketCount"] = 0;
}

<div class="portal-shell">
    <partial name="_Sidebar" />

    <div class="portal-content">
        <div class="portal-header">
            <div>
                <h1>My service</h1>
                <p class="sub">Everything about your line, equipment and package.</p>
            </div>
        </div>

        <partial name="_Alerts" />

        @if (Model.Service is null)
        {
            <div class="panel">
                <div class="empty-state">
                    <div class="icon"><i class="bi bi-router"></i></div>
                    <h2 class="h5" style="color: var(--t25-navy);">No service on your account yet</h2>
                    <p>Once we confirm fibre is available at your address, your service details will appear here.</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a class="btn btn-primary" asp-controller="Home" asp-action="Coverage">Check my address</a>
                        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Contact">Talk to sales</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3 mb-4">
                <div class="col-6 col-lg-3">
                    <div class="stat-card green">
                        <div class="stat-label">Status</div>
                        <div class="stat-value" style="font-size: 1.3rem;">@Model.Service.ServiceStatus</div>
                        <div class="stat-hint">Since @Model.Service.ActivatedOn.ToString("MMM yyyy")</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="stat-label">Down / Up</div>
                        <div class="stat-value" style="font-size: 1.3rem;">
                            @Model.Plan?.DownloadMbps / @Model.Plan?.UploadMbps
                        </div>
                        <div class="stat-hint">Mbps symmetrical</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card cyan">
                        <div class="stat-label">Data used</div>
                        <div class="stat-value">@Model.DataUsedGb<small style="font-size: 0.9rem;"> GB</small></div>
                        <div class="stat-hint">Uncapped this month</div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card amber">
                        <div class="stat-label">Monthly fee</div>
                        <div class="stat-value" style="font-size: 1.3rem;">R@(Model.Service.MonthlyPrice.ToString("N0"))</div>
                        <div class="stat-hint">Next bill @Model.Service.NextBillingDate.ToString("d MMM")</div>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="panel">
                        <h2>Package details</h2>
                        <div class="detail-row">
                            <span class="k">Plan</span>
                            <span class="v">@Model.Plan?.Name</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Download</span>
                            <span class="v">@Model.Plan?.DownloadMbps Mbps</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Upload</span>
                            <span class="v">@Model.Plan?.UploadMbps Mbps</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Data</span>
                            <span class="v">@(Model.Plan?.IsUncapped == true ? "Uncapped" : Model.Plan?.DataCap)</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Contract start</span>
                            <span class="v">@Model.Service.ActivatedOn.ToString("d MMMM yyyy")</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Contract ends</span>
                            <span class="v">@Model.Service.ContractEndDate.ToString("d MMMM yyyy")</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Next billing date</span>
                            <span class="v">@Model.Service.NextBillingDate.ToString("d MMMM yyyy")</span>
                        </div>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between text-muted mb-1" style="font-size: 0.8rem;">
                                <span>Contract progress</span>
                                <span>@Model.ContractProgressPercent%</span>
                            </div>
                            <div class="usage-bar">
                                <div class="fill" style="width: @Model.ContractProgressPercent.ToString("0.##")%;"></div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Service.Notes))
                        {
                            <div class="alert alert-light border mt-3 mb-0" style="font-size: 0.88rem;">
                                <i class="bi bi-info-circle me-1"></i>@Model.Service.Notes
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="panel">
                        <h2>Equipment &amp; connection</h2>
                        <div class="detail-row">
                            <span class="k">ONT serial</span>
                            <span class="v">@Model.Service.OntSerialNumber</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Router</span>
                            <span class="v">@Model.Service.RouterModel</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Fibre type</span>
                            <span class="v">@Model.Service.FibreType</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Public IP</span>
                            <span class="v">@Model.Service.PublicIpAddress</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">MAC address</span>
                            <span class="v">@Model.Service.MacAddress</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Installed at</span>
                            <span class="v">@Model.Service.InstallationAddress</span>
                        </div>
                        <div class="detail-row">
                            <span class="k">Account number</span>
                            <span class="v">@Model.Service.AccountNumber</span>
                        </div>
                    </div>

                    <div class="panel">
                        <h2>Upgrade your speed</h2>
                        @if (Model.AvailableUpgrades.Any())
                        {
                            <p class="text-muted" style="font-size: 0.9rem;">
                                You can move up at any time. We'll apply the new speed within 24 hours and
                                pro-rate the difference on your next invoice.
                            </p>
                            @foreach (var upgrade in Model.AvailableUpgrades)
                            {
                                <div class="d-flex justify-content-between align-items-center gap-2 py-2"
                                     style="border-bottom: 1px dashed #EAEFF7;">
                                    <div>
                                        <div class="fw-semibold" style="color: var(--t25-navy);">@upgrade.Name</div>
                                        <div class="text-muted" style="font-size: 0.8rem;">
                                            @upgrade.DownloadMbps Mbps &middot; R@(upgrade.MonthlyPrice.ToString("0"))/month
                                        </div>
                                    </div>
                                    <form asp-action="RequestUpgrade" asp-controller="Service" method="post" class="d-inline">
                                        <input type="hidden" name="planId" value="@upgrade.Id" />
                                        <button class="btn btn-sm btn-primary" type="submit">Request</button>
                                    </form>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <div class="icon"><i class="bi bi-arrow-up-circle"></i></div>
                                <p class="mb-0">You're already on our fastest package available to you.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
