@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="hero" style="padding: 3rem 0 4.5rem;">
    <div class="container">
        <div class="col-lg-8">
            <p class="text-eyebrow mb-2">Legal</p>
            <h1 style="font-size: clamp(1.9rem, 4vw, 2.8rem);">Privacy policy</h1>
            <p class="lead">How Three25IT handles your personal information.</p>
        </div>
    </div>
</section>

<section class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="panel">
                <h2>Who we are</h2>
                <p class="text-muted" style="font-size: 0.92rem;">
                    Three25IT Communications (Pty) Ltd is an internet service provider offering fibre
                    broadband to homes and businesses. This is a demonstration website and the
                    details below are illustrative sample content.
                </p>

                <h2 class="mt-4">What we collect</h2>
                <ul class="text-muted" style="font-size: 0.92rem;">
                    <li>Account details: name, email address, contact number and service address.</li>
                    <li>Billing information: invoices issued, payments received and your transaction history.</li>
                    <li>Technical data: ONT serial number, public IP address and monthly usage volumes.</li>
                    <li>Support records: the content of any support tickets you raise with us.</li>
                </ul>

                <h2 class="mt-4">How we use it</h2>
                <ul class="text-muted" style="font-size: 0.92rem;">
                    <li>To provide, monitor and support your internet service.</li>
                    <li>To bill you accurately and process payments.</li>
                    <li>To plan network capacity and improve coverage in your area.</li>
                    <li>To communicate about outages, maintenance and account changes.</li>
                </ul>

                <h2 class="mt-4">What we never do</h2>
                <ul class="text-muted" style="font-size: 0.92rem;">
                    <li>We do not sell your personal information to third parties.</li>
                    <li>We do not inspect, log or retain the content of your internet traffic.</li>
                    <li>We do not use your usage data for advertising.</li>
                </ul>

                <h2 class="mt-4">How long we keep it</h2>
                <p class="text-muted" style="font-size: 0.92rem;">
                    Account and billing records are retained for five years after your service ends, as
                    required by South African tax law. Support tickets are retained for two years.
                    Usage records are deleted after 24 months.
                </p>

                <h2 class="mt-4">Your rights (POPIA)</h2>
                <p class="text-muted" style="font-size: 0.92rem;">
                    Under the Protection of Personal Information Act you have the right to access,
                    correct or delete your personal information, and to object to how it is used. Send
                    any such request to
                    <a href="mailto:privacy@three25it.co.za">privacy@three25it.co.za</a> and we will
                    respond within 30 days. If you're unhappy with our response you can complain to
                    the Information Regulator of South Africa.
                </p>

                <h2 class="mt-4">Contact</h2>
                <p class="text-muted" style="font-size: 0.92rem;">
                    Three25IT Communications (Pty) Ltd<br />
                    Email: <a href="mailto:privacy@three25it.co.za">privacy@three25it.co.za</a><br />
                    Phone: <a href="tel:0860000325">0860 000 325</a>
                </p>

                <div class="alert alert-light border mt-4 mb-0" style="font-size: 0.86rem;">
                    <i class="bi bi-info-circle me-1"></i>
                    This policy is sample content for demonstration purposes and is not legal advice.
                </div>
            </div>
        </div>
    </div>
</section>
